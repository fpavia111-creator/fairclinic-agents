{
  "name": "fairclinic-agents",
  "lockfileVersion": 3,
  "requires": true,
  "packages": {
    "": {
      "name": "fairclinic-agents",
      "license": "MIT",
      "workspaces": [
        "packages/fairclinic-core",
        "packages/*"
      ],
      "engines": {
        "node": ">=20"
      }
    },
    "node_modules/fairclinic-core": {
      "resolved": "packages/fairclinic-core",
      "link": true
    },
    "node_modules/otter-of-claims": {
      "resolved": "packages/otter-of-claims",
      "link": true
    },
    "packages/fairclinic-core": {
      "version": "0.2.0",
      "license": "MIT",
      "bin": {
        "fairclinic-approve": "bin/fairclinic-approve.js",
        "fairclinic-license": "bin/fairclinic-license.js",
        "fairclinic-new-agent": "bin/fairclinic-new-agent.js",
        "fairclinic-verify-log": "bin/fairclinic-verify-log.js"
      },
      "engines": {
        "node": ">=20"
      }
    },
    "packages/otter-of-claims": {
      "version": "0.1.0",
      "license": "MIT",
      "dependencies": {
        "fairclinic-core": "^0.2.0"
      },
      "bin": {
        "otter-of-claims": "bin/otter-of-claims.js"
      },
      "engines": {
        "node": ">=20"
      }
    }
  }
}
