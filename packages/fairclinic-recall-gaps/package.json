{
  "name": "fairclinic-recall-gaps",
  "version": "0.1.0",
  "description": "Fairclinic Recall Gaps: dental recall and hygiene patients who are overdue and not booked, missed a booked visit, are due soon, or have lapsed, with the last contact date; and how many hygiene visits leave with the next visit booked, per hygienist. Patient names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-recall-gaps": "bin/fairclinic-recall-gaps.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-recall-gaps.js demo",
    "eval": "node bin/fairclinic-recall-gaps.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-recall-gaps"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-recall-gaps#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "dental",
    "recall",
    "hygiene",
    "reappointment",
    "patient-reactivation"
  ]
}
