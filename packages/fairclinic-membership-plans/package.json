{
  "name": "fairclinic-membership-plans",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-membership-plans",
  "description": "Fairclinic Membership Plans: a month of in-house dental membership (savings) plan billing against the roster: missed and failed charges, wrong amounts, charges after cancelling, plan use after a membership ended, annual renewals due or lapsed, and charges for people not on the roster. It never charges, retries or refunds. Member names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-membership-plans": "bin/fairclinic-membership-plans.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-membership-plans.js demo",
    "eval": "node bin/fairclinic-membership-plans.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-membership-plans"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-membership-plans#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
