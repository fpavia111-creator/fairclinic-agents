{
  "name": "fairclinic-vaccine-reminders",
  "version": "0.1.0",
  "description": "Fairclinic Vaccine Reminders: reads the veterinary practice system's reminder list for pets that are overdue and not booked, overdue with no recent reminder, due soon with no reminder, clients with no e-mail or phone, and reminders sent for pets marked deceased or inactive. Due dates come from your system; it never sets a schedule or sends a reminder. Pet and client names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-vaccine-reminders": "bin/fairclinic-vaccine-reminders.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-vaccine-reminders.js demo",
    "eval": "node bin/fairclinic-vaccine-reminders.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-vaccine-reminders"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-vaccine-reminders#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "veterinary",
    "vaccine-reminders",
    "compliance-rate",
    "client-communication",
    "cornerstone"
  ]
}
