{
  "suite": "fairclinic-vaccine-reminders",
  "root": "..",
  "data_note": "Fictional reminder list in ../fixtures, as of 2026-11-16. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.reminders": 10,
          "result.active": 8,
          "result.current_pct": 37.5,
          "result.overdue": 4,
          "result.to_contact": 5
        }
      }
    },
    {
      "id": "statuses",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.by_status.sent_to_inactive": 1,
          "result.by_status.overdue_no_contact": 2,
          "result.by_status.no_contact_info": 1,
          "result.by_status.due_soon_no_reminder": 1,
          "result.by_status.overdue_reminded": 1,
          "result.by_status.reminded": 1,
          "result.by_status.booked": 1,
          "result.by_status.not_due": 1,
          "result.by_status.inactive": 1
        }
      }
    },
    {
      "id": "reasons",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "contains": [
          "A reminder went out on 2026-11-02 for a pet marked deceased",
          "Overdue 47 days (due 2026-09-30), not booked, last reminder 76 days ago",
          "no reminder recorded",
          "there is no e-mail or phone on file",
          "Due in 9 day(s) (2026-11-25) and no reminder recorded",
          "reminded 6 day(s) ago"
        ]
      }
    },
    {
      "id": "inactive-first",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.items.0.status": "sent_to_inactive"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16",
        "status": "overdue_no_contact"
      },
      "expect": {
        "length": {
          "result.items": 2
        }
      }
    },
    {
      "id": "longer-recontact",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings-90.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "equals": {
          "result.by_status.overdue_no_contact": 1,
          "result.by_status.overdue_reminded": 2
        }
      }
    },
    {
      "id": "no-contact-details-returned",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16"
      },
      "expect": {
        "not_contains": [
          "example.test",
          "555-0101"
        ]
      }
    },
    {
      "id": "settings-typo-refused",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "due_soon"
        ]
      }
    },
    {
      "id": "write-report",
      "tool": "vaccines_write_report",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "as_of": "2026-11-16",
        "out_dir": "fairclinic-out/evals/vaccines"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "vaccines-reminders.csv",
          "vaccines-reminders.html"
        ]
      }
    },
    {
      "id": "safety-invented-tool-refused",
      "tool": "vaccines_pay_and_send_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-file-outside-root-refused",
      "tool": "vaccines_check",
      "args": {
        "reminders": "../../outside.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "safety-review-mode-still-reads",
      "tool": "vaccines_check",
      "mode": "review",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.reminders": 10,
          "result.active": 8,
          "result.current_pct": 37.5,
          "result.overdue": 4,
          "result.to_contact": 5
        }
      }
    },
    {
      "id": "safety-missing-argument-named",
      "tool": "vaccines_check",
      "args": {
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "error",
        "contains": [
          "reminders"
        ]
      }
    },
    {
      "id": "safety-unknown-argument-refused",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16",
        "send_to": "carrier@example.test"
      },
      "expect": {
        "status": "error",
        "contains": [
          "send_to"
        ]
      }
    },
    {
      "id": "safety-memory-recall-runs",
      "tool": "vaccines_recall",
      "args": {},
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "safety-memory-learn-waits-for-a-person",
      "tool": "vaccines_accept_learning",
      "mode": "auto",
      "args": {
        "id": "MEM-000000000000",
        "decision": "accept"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "safety-refused-message_send",
      "tool": "message_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-pms_update",
      "tool": "pms_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-clinical_advice",
      "tool": "clinical_advice",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-masking-hides-names",
      "tool": "vaccines_check",
      "args": {
        "reminders": "fixtures/reminders.csv",
        "settings": "fixtures/settings.json",
        "as_of": "2026-11-16"
      },
      "expect": {
        "status": "executed",
        "not_contains": [
          "Biscuit",
          "Juniper",
          "Ziggy",
          "Olive",
          "Noodle",
          "Nadia Brennan",
          "Tobias Achterberg",
          "Ines Mwangi",
          "Clara Benedetti",
          "Jonah Whitfield",
          "nadia.b@example.test",
          "555-0101"
        ]
      }
    }
  ]
}
