{
  "suite": "fairclinic-boarding-grooming",
  "root": "..",
  "data_note": "Fictional reservations and invoice lines in ../fixtures. No model is called.",
  "cases": [
    { "id": "totals", "tool": "boarding_check", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv", "settings": "fixtures/settings.json" },
      "expect": { "status": "executed", "equals": { "result.reservations": 6, "result.cancelled": 1, "result.to_review": 3, "result.missed_value": 155, "result.by_finding.not_invoiced": 1, "result.by_finding.nights_short": 1, "result.by_finding.addon_not_invoiced": 2 } } },
    { "id": "reasons", "tool": "boarding_check", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv", "settings": "fixtures/settings.json" },
      "expect": { "contains": ["7 night(s) from 2026-11-02 to 2026-11-09; 6 invoiced", "Add-on Medication admin was booked and is not on the invoice (5)", "Grooming - full 2026-11-06 has no invoice lines", "Add-on Exit bath was booked and is not on the invoice (30)"] } },
    { "id": "without-prices", "tool": "boarding_check", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv" },
      "expect": { "equals": { "result.missed_value": 0, "result.to_review": 3 } } },
    { "id": "status-filter", "tool": "boarding_check", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv", "status": "ok" },
      "expect": { "length": { "result.items": 2 } } },
    { "id": "settings-typo-refused", "tool": "boarding_check", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv", "settings": "fixtures/settings-typo.json" },
      "expect": { "status": "error", "contains": ["price_list"] } },
    { "id": "write-report", "tool": "boarding_write_report", "args": { "reservations": "fixtures/reservations.csv", "invoices": "fixtures/shepherd-invoice-items.csv", "settings": "fixtures/settings.json", "out_dir": "fairclinic-out/evals/boarding" },
      "expect": { "status": "executed", "contains": ["boarding-invoices.csv", "boarding-invoices.html"] } }
  ]
}
