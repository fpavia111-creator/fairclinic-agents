{
  "name": "fairclinic-supply-costs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-supply-costs",
  "description": "Fairclinic Supply Costs: dental or veterinary supplier invoices against production: supplies as a percent of production by month, unit prices up from the last price paid, the same line twice on an invoice, and categories far above their other months. It never pays a supplier or places an order.",
