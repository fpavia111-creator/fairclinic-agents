{
  "name": "fairclinic-missed-charges",
  "version": "0.1.0",
  "description": "Fairclinic Missed Charges: what a veterinary treatment sheet or medical record says was done, against what was invoiced, matched by visit (or pet and date) and item: items not invoiced, quantities invoiced short, lines at no charge to confirm, and invoiced items missing from the record, valued from your price list. Pet and client names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-missed-charges": "bin/fairclinic-missed-charges.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-missed-charges.js demo",
    "eval": "node bin/fairclinic-missed-charges.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-missed-charges"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-missed-charges#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "veterinary",
    "missed-charges",
    "charge-capture",
    "invoicing",
    "ezyvet"
  ]
}
