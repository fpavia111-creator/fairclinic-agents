{
  "name": "fairclinic-era-posting",
  "version": "0.1.0",
  "description": "Fairclinic ERA Posting: reads dental ERAs (835 files or remittance exports) and compares each claim with what was posted in the practice system: payments not posted, posted amounts that differ, contractual write-offs that differ from the ERA, denials written off as contractual, reversals, postings that are not on the ERA, and check totals that do not tie. Patient names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-era-posting": "bin/fairclinic-era-posting.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-era-posting.js demo",
    "eval": "node bin/fairclinic-era-posting.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-era-posting"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-era-posting#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "dental",
    "dental-billing",
    "era",
    "835",
    "remittance",
    "payment-posting"
  ]
}
