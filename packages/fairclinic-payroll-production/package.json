{
  "name": "fairclinic-payroll-production",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-payroll-production",
  "description": "Fairclinic Payroll Production: dental or veterinary payroll hours and pay against collections per pay period: payroll as a percent of collections, collections per paid hour, periods over your target or missing a collections figure, high overtime by employee, and totals by role. Not a wage-and-hour review; it never changes pay or runs payroll.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-payroll-production": "bin/fairclinic-payroll-production.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-payroll-production.js demo",
    "eval": "node bin/fairclinic-payroll-production.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-payroll-production"
  },
