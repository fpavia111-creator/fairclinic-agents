{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.fpavia111-creator/fairclinic-no-shows",
  "title": "Fairclinic No Shows",
  "description": "Fairclinic No-shows: dental or veterinary appointments that were missed or cancelled late and not…",
  "version": "0.1.0",
  "repository": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents",
    "source": "github",
    "subfolder": "packages/fairclinic-no-shows"
  },
  "websiteUrl": "https://fair-agents.com/fairclinic.html",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "fairclinic-no-shows",
      "version": "0.1.0",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "mcp"
        },
        {
          "type": "named",
          "name": "--root",
          "description": "Folder holding the exports this agent may read and write (it cannot reach outside it)",
          "isRequired": true,
          "format": "filepath",
          "valueHint": "exports_folder"
        }
      ]
    }
  ]
}
