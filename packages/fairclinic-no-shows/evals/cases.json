{
  "suite": "fairclinic-no-shows",
  "root": "..",
  "data_note": "Fictional appointments in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "totals",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.appointments": 10,
          "result.no_shows": 4,
          "result.no_show_pct": 40,
          "result.late_cancels": 2,
          "result.unfilled_value": 2765,
          "result.to_review": 4,
          "result.by_status.repeat_no_show": 1,
          "result.by_status.no_show_not_rebooked": 2,
          "result.by_status.late_cancel_not_rebooked": 1,
          "result.by_finding.fee_not_charged": 3
        }
      }
    },
    {
      "id": "reasons",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "contains": [
          "No-show number 2 for this patient",
          "Missed the 2026-11-03 appointment and is not rebooked",
          "Cancelled the same day and not rebooked",
          "Your policy has a 25 no-show fee and none was charged"
        ]
      }
    },
    {
      "id": "by-provider",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv"
      },
      "expect": {
        "equals": {
          "result.by_provider.0.provider": "Hana Test",
          "result.by_provider.0.no_show_pct": 75,
          "result.by_provider.1.provider": "Dr. Ben Sample",
          "result.by_provider.1.no_shows": 1
        }
      }
    },
    {
      "id": "without-fee-policy",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv"
      },
      "expect": {
        "not_contains": [
          "no-show fee and none was charged"
        ]
      }
    },
    {
      "id": "shorter-late-window",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings-1day.json"
      },
      "expect": {
        "equals": {
          "result.late_cancels": 1
        }
      }
    },
    {
      "id": "settings-typo-refused",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "late_days"
        ]
      }
    },
    {
      "id": "write-report",
      "tool": "noshows_write_report",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json",
        "out_dir": "fairclinic-out/evals/noshows"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "noshows-follow-up.csv",
          "noshows-follow-up.html"
        ]
      }
    },
    {
      "id": "safety-invented-tool-refused",
      "tool": "noshows_pay_and_send_everything_now",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-file-outside-root-refused",
      "tool": "noshows_check",
      "args": {
        "appointments": "../../outside.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "outside"
        ]
      }
    },
    {
      "id": "safety-review-mode-still-reads",
      "tool": "noshows_check",
      "mode": "review",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.appointments": 10,
          "result.no_shows": 4,
          "result.no_show_pct": 40,
          "result.late_cancels": 2,
          "result.unfilled_value": 2765,
          "result.to_review": 4,
          "result.by_status.repeat_no_show": 1,
          "result.by_status.no_show_not_rebooked": 2,
          "result.by_status.late_cancel_not_rebooked": 1,
          "result.by_finding.fee_not_charged": 3
        }
      }
    },
    {
      "id": "safety-missing-argument-named",
      "tool": "noshows_check",
      "args": {
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "appointments"
        ]
      }
    },
    {
      "id": "safety-unknown-argument-refused",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json",
        "send_to": "carrier@example.test"
      },
      "expect": {
        "status": "error",
        "contains": [
          "send_to"
        ]
      }
    },
    {
      "id": "safety-memory-recall-runs",
      "tool": "noshows_recall",
      "args": {},
      "expect": {
        "status": "executed"
      }
    },
    {
      "id": "safety-memory-learn-waits-for-a-person",
      "tool": "noshows_accept_learning",
      "mode": "auto",
      "args": {
        "id": "MEM-000000000000",
        "decision": "accept"
      },
      "expect": {
        "status": "needs_approval"
      }
    },
    {
      "id": "safety-refused-message_send",
      "tool": "message_send",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-pms_update",
      "tool": "pms_update",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-refused-client_charge",
      "tool": "client_charge",
      "mode": "auto",
      "args": {},
      "expect": {
        "status": "blocked"
      }
    },
    {
      "id": "safety-masking-hides-names",
      "tool": "noshows_check",
      "args": {
        "appointments": "fixtures/appointments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "not_contains": [
          "Rowan Achebe",
          "Marisol Quintero",
          "Theo Vasquez-Lind",
          "Priya Halvorsen",
          "Kenji Abernathy",
          "Lucia Fontaine",
          "Omar Brightwater",
          "Greta Lindqvist",
          "Dmitri Okonkwo"
        ]
      }
    }
  ]
}
