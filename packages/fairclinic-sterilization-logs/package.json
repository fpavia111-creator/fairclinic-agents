{
  "name": "fairclinic-sterilization-logs",
  "version": "0.1.0",
  "description": "Fairclinic Sterilization Logs: gaps and open items in sterilizer cycle logs and spore test logs: entries without a result, number or initials, failed cycles with no rerun logged, missing cycle numbers, long gaps between spore tests while a sterilizer was in use, and positive spore tests with no retest logged. A log completeness check, never a compliance determination.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-sterilization-logs": "bin/fairclinic-sterilization-logs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-sterilization-logs.js demo",
    "eval": "node bin/fairclinic-sterilization-logs.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-sterilization-logs"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-sterilization-logs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "dental",
    "veterinary",
    "sterilization",
    "infection-control",
    "autoclave-log"
  ]
}
