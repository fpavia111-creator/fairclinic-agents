{
  "name": "fairclinic-controlled-drugs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-controlled-drugs",
  "description": "Fairclinic Controlled Drugs: reconciles a veterinary controlled drug log (DEA schedule items) with the physical count: the balance worked out from the entries against the written balance and the count, arithmetic errors that hide a difference, waste with no witness, use with no patient, entries with no initials. It reports the log; it never decides compliance or files anything. Pet and client names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-controlled-drugs": "bin/fairclinic-controlled-drugs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-controlled-drugs.js demo",
    "eval": "node bin/fairclinic-controlled-drugs.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-controlled-drugs"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-controlled-drugs#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "veterinary",
    "controlled-substances",
    "dea",
    "drug-log",
    "inventory"
  ]
}
