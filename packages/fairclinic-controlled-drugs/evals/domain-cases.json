{
  "suite": "fairclinic-controlled-drugs",
  "root": "..",
  "data_note": "Fictional controlled drug log and counts in ../fixtures. No model is called.",
  "cases": [
    { "id": "totals", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv", "settings": "fixtures/settings.json" },
      "expect": { "status": "executed", "equals": { "result.drugs": 4, "result.entries": 16, "result.to_review": 6, "result.count_mismatches": 2, "result.by_status.balance_math": 1, "result.by_status.waste_no_witness": 1, "result.by_status.no_patient": 1, "result.by_status.missing_initials": 1 } } },
    { "id": "reasons", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv" },
      "expect": { "contains": ["Balance written as 18; 18.8 - 0.6 is 18.2 (off by -0.2)", "Counted 17.5 on 2026-11-15; the log's entries add up to 17.7 (short by 0.2). The written balance (17.5) hides it", "Counted 36.5 on 2026-11-15; the log's entries add up to 37.5 (short by 1)", "Waste of 0.2 on 2026-11-05 with no witness", "0.5 administered on 2026-11-08 with no patient", "Entry on 2026-11-11 has no initials", "not a compliance finding"] } },
    { "id": "by-drug", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv" },
      "expect": { "equals": { "result.by_drug.0.drug": "Butorphanol 10 mg/mL", "result.by_drug.0.difference": -1, "result.by_drug.2.log_balance": 17.7, "result.by_drug.2.written_balance": 17.5, "result.by_drug.3.status": "ok" } } },
    { "id": "witness-off-by-protocol", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv", "settings": "fixtures/settings-nowitness.json" },
      "expect": { "equals": { "result.to_review": 5 } } },
    { "id": "drug-not-counted", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts-partial.csv" },
      "expect": { "equals": { "result.by_status.no_count": 2 } } },
    { "id": "settings-typo-refused", "tool": "drugs_check", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv", "settings": "fixtures/settings-typo.json" },
      "expect": { "status": "error", "contains": ["witness_needed"] } },
    { "id": "write-report", "tool": "drugs_write_report", "args": { "log": "fixtures/controlled-log.csv", "counts": "fixtures/counts.csv", "out_dir": "fairclinic-out/evals/drugs" },
      "expect": { "status": "executed", "contains": ["drugs-reconciliation.csv", "drugs-reconciliation.html"] } }
  ]
}
