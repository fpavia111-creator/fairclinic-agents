{
  "name": "fairclinic-ppo-writeoffs",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-ppo-writeoffs",
  "description": "Fairclinic PPO Write-offs: dental adjustments and write-offs split into contractual (PPO) and discretionary, with write-off percent of production by carrier and discretionary adjustments by the person who entered them; flags duplicates, contractual write-offs for out-of-network carriers or no carrier, adjustments without a reason, and large ones. Patient names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-ppo-writeoffs": "bin/fairclinic-ppo-writeoffs.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-ppo-writeoffs.js demo",
    "eval": "node bin/fairclinic-ppo-writeoffs.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-ppo-writeoffs"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-ppo-writeoffs#readme",
