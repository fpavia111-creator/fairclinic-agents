{
  "name": "fairclinic-lab-cases",
  "version": "0.1.0",
  "mcpName": "io.github.fpavia111-creator/fairclinic-lab-cases",
  "description": "Fairclinic Lab Cases: the dental lab case log against seat appointments, billing and lab invoices: cases not back for the seat appointment, overdue from the lab, seated and not billed, remakes charged, duplicate invoices, invoices for cases not in the log or not back yet, and returned cases with no invoice. It never pays a lab or changes a case. Patient names are masked before results reach the model.",
  "type": "module",
  "license": "MIT",
  "author": "Kurt Francisco",
  "engines": {
    "node": ">=20"
  },
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js",
    "./package.json": "./package.json"
  },
  "bin": {
    "fairclinic-lab-cases": "bin/fairclinic-lab-cases.js"
  },
  "files": [
    "src",
    "bin",
    "fixtures",
    "evals",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "server.json"
  ],
  "scripts": {
    "test": "node scripts/run-tests.cjs",
    "demo": "node bin/fairclinic-lab-cases.js demo",
    "eval": "node bin/fairclinic-lab-cases.js eval"
  },
  "dependencies": {
    "fairclinic-core": "^0.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/fpavia111-creator/fairclinic-agents.git",
    "directory": "packages/fairclinic-lab-cases"
  },
  "homepage": "https://github.com/fpavia111-creator/fairclinic-agents/tree/main/packages/fairclinic-lab-cases#readme",
  "bugs": {
    "url": "https://github.com/fpavia111-creator/fairclinic-agents/issues"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "fairclinic",
    "practice-management",
    "dental",
    "dental-lab",
    "lab-cases",
    "lab-invoices",
    "accounts-payable"
  ]
}
