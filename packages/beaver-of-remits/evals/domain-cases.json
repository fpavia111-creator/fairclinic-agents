{
  "suite": "beaver-of-remits",
  "root": "..",
  "data_note": "Fictional dental ERAs and postings in ../fixtures. No model is called.",
  "cases": [
    {
      "id": "posting-totals",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv",
        "settings": "fixtures/settings.json"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.era_claims": 7,
          "result.era_paid": 1550.6,
          "result.posted_paid": 1868.8,
          "result.not_posted": 1,
          "result.unposted_amount": 76.8,
          "result.mismatches": 2,
          "result.denials_written_off": 1,
          "result.reversals": 1,
          "result.not_on_era": 1,
          "result.checks_not_tying": 2
        }
      }
    },
    {
      "id": "every-planted-issue",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "contains": [
          "Posted write-off 196, the ERA's contractual adjustment is 245",
          "76.8 was paid on EFT1101 and no posting",
          "Denied (CO-29) but 540 was posted as a write-off",
          "Posted 652, the ERA paid 625",
          "reversed 248",
          "is not on that ERA"
        ]
      }
    },
    {
      "id": "check-totals",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "equals": {
          "result.checks.0.check_number": "CHK55210",
          "result.checks.0.difference": 275,
          "result.checks.1.era_amount": 933.6,
          "result.checks.1.difference": 43.2
        }
      }
    },
    {
      "id": "other-checks-left-out",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "not_contains": [
          "CHK40001"
        ]
      }
    },
    {
      "id": "patient-portion",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "equals": {
          "result.patient_portion": 668.4
        }
      }
    },
    {
      "id": "clean-claim-explained",
      "tool": "beaver_explain",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv",
        "claim": "C2001"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.claim.status": "ok",
          "result.claim.writeoff_expected": 84
        },
        "contains": [
          "Posted as the ERA shows"
        ]
      }
    },
    {
      "id": "denial-with-no-posting-is-to-work",
      "tool": "beaver_explain",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/era-export.csv",
        "claim": "C2004"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.claim.status": "denied"
        }
      }
    },
    {
      "id": "status-filter",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv",
        "status": "ok"
      },
      "expect": {
        "length": {
          "result.items": 2
        }
      }
    },
    {
      "id": "era-export-one-row-per-adjustment",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-export.csv",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "status": "executed",
        "equals": {
          "result.era_claims": 3,
          "result.era_paid": 933.6,
          "result.not_posted": 1,
          "result.mismatches": 1
        }
      }
    },
    {
      "id": "settings-typo-refused",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv",
        "settings": "fixtures/settings-typo.json"
      },
      "expect": {
        "status": "error",
        "contains": [
          "tolerence"
        ]
      }
    },
    {
      "id": "not-an-835",
      "tool": "beaver_check",
      "args": {
        "era": "fixtures/README.md",
        "posted": "fixtures/posted-payments.csv"
      },
      "expect": {
        "status": "error"
      }
    },
    {
      "id": "write-report",
      "tool": "beaver_write_report",
      "args": {
        "era": "fixtures/era-2026-11.835",
        "posted": "fixtures/posted-payments.csv",
        "out_dir": "fairclinic-out/evals/beaver"
      },
      "expect": {
        "status": "executed",
        "contains": [
          "beaver-era-posting.csv",
          "beaver-era-posting.html"
        ]
      }
    }
  ]
}
